# ============================================================================
# UNIPORTAL DOCKER DEPLOYMENT - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env for local Docker testing, then replace the dummy values
# with production values in Dockploy.
# ============================================================================

# Django
DEBUG=False
SECRET_KEY=django-insecure-change-this-to-a-very-long-random-string-in-production
DJANGO_SETTINGS_MODULE=config.settings.docker
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,api.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com
MINI_APP_URL=https://yourdomain.com

# Security
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# PostgreSQL
DB_NAME=uniportal
DB_USER=postgres
DB_PASSWORD=your-very-secure-database-password-here
DB_HOST=postgres
DB_PORT=5432

# Cloudflare R2 media storage
USE_S3=False
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://r2.yourdomain.com

# AWS-compatible aliases accepted by config.settings.docker
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=https://r2.yourdomain.com

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_OFFICIAL_CHANNEL_ID=
TELEGRAM_CHANNEL_LINK=https://t.me/unityuniversityportal
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://api.yourdomain.com/api/telegram/webhook/

# AI APIs
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-google-gemini-api-key
GOOGLE_API_KEY=your-google-gemini-api-key

# Runtime
GUNICORN_WORKERS=4
LOG_LEVEL=INFO
