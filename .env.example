# Local development only. Set real secrets/hosts in Railway; see docs/PHASE_6_OPERATIONS.md.
DEBUG=True
SECRET_KEY=django-insecure-local-only-replace-with-a-random-key
DJANGO_SETTINGS_MODULE=config.settings.docker
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000
MINI_APP_URL=http://localhost:3000

# Enable only after verifying the proxy overwrites the forwarded scheme header.
TRUST_PROXY_HTTPS=False
SECURE_SSL_REDIRECT=False
THROTTLE_NUM_PROXIES=0
DB_CONN_MAX_AGE=60
DB_NAME=uniportal
DB_USER=postgres
DB_PASSWORD=local-only-change-me
DB_HOST=postgres
DB_PORT=5432
# Railway should set DATABASE_URL to its PostgreSQL service reference.

USE_S3=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
# R2 remains private. Links are signed; no public-domain setting is needed.

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_OFFICIAL_CHANNEL_ID=
TELEGRAM_CHANNEL_LINK=https://t.me/unityuniversityportal
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as an alias in container/production settings.
GEMINI_MODEL=gemini-3.1-flash-lite
# These bound requests; they do not determine your Google project's billing tier.
AI_MAX_CALLS_PER_JOB=10
AI_QUOTA_RETRY_SECONDS=1800
GUNICORN_WORKERS=2
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
MAX_DOCUMENT_UPLOAD_BYTES=104857600
MAX_EXAM_PDF_UPLOAD_BYTES=20971520
